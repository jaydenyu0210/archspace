{
  "name": "@archspace/app",
  "version": "0.1.0",
  "private": true,
  "description": "Archspace desktop shell: Electron main + renderer (ARCHITECTURE \u00a73)",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/check-bundle.mjs",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && node scripts/check-bundle.mjs && electron-builder --mac --universal --publish never",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@archspace/ai-gateway": "workspace:*",
    "@archspace/autodesk": "workspace:*",
    "@archspace/document": "workspace:*",
    "@archspace/engine": "workspace:*",
    "@archspace/mcp-host": "workspace:*",
    "@archspace/node-sdk": "workspace:*",
    "@archspace/nodes-core": "workspace:*",
    "@archspace/plugin-host": "workspace:*",
    "@archspace/types": "workspace:*",
    "@xyflow/react": "^12.11.3",
    "electron-updater": "^6.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
