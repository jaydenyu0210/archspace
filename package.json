{
  "name": "archspace",
  "private": true,
  "version": "0.1.0",
  "description": "Node-based workflows for AEC work — monorepo root",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @archspace/app dev",
    "build": "pnpm --filter @archspace/plugin-aec-review build && pnpm --filter @archspace/app build",
    "dist": "pnpm --filter @archspace/plugin-aec-review build && pnpm --filter @archspace/app dist",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "cli": "tsx packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.68.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
